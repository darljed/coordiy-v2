# Environment
NODE_ENV="development"

# Database
DATABASE_URL_DEV="postgresql://neondb_username:password@neondb_url/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_PROD="postgresql://username:password@production-host:5432/coordiy_prod?sslmode=require"

# JWT Secret (generate a strong secret key)
JWT_SECRET="app-jwt-secret-2025-production-ready-key"

# Email Configuration (AWS SES)
EMAIL_HOST="smtp-host"
EMAIL_PORT="587"
EMAIL_USER="smtp-username"
EMAIL_PASS="smtp-password"
EMAIL_FROM="darl@darl.dev"

# App Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="app-nextauth-secret-2024"

# Email Verification
EMAIL_VERIFICATION_SECRET="app-email-verification-secret-2025"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# OAuth Feature Flags
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="true"
NEXT_PUBLIC_ENABLE_FACEBOOK_AUTH="true"